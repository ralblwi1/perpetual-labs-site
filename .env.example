# Set these in Vercel → Project → Settings → Environment Variables (Production).
# Do NOT commit real values — this file documents the variable names only.

# Shared password for general Research, QuantBench, and Data Room content.
# Company-specific pages use separate credentials.
DATA_PASSWORD=your-general-data-password-here

# Legacy fallback used only when DATA_PASSWORD is not set.
NEWSLETTER_PASSWORD=your-legacy-team-password-here

# HMAC signing key for session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=generate-a-long-random-string

# Added automatically when the private QuantBench Blob store is connected.
# Do not expose this value to browser code.
BLOB_READ_WRITE_TOKEN=managed-by-vercel
